# bldr — path attributes
#
# Line endings, binary markers, GitHub language classification, and diff
# drivers. Existing checkouts will not renormalize on their own; run
# `git add --renormalize .` once if a stale CRLF file shows up in a diff.

# ─── Line endings ────────────────────────────────────────────────────────────
# LF in the repository and in the working tree. Shell scripts and the vendored
# BLAKE3 sources break outright with CRLF, so those are pinned explicitly.
*                   text=auto eol=lf

*.sh                text eol=lf
*.bash              text eol=lf
Makefile            text eol=lf
*.mk                text eol=lf

*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf

# ─── Binary ──────────────────────────────────────────────────────────────────
*.vsix              binary
*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.ico               binary
*.pdf               binary
*.zip               binary
*.gz                binary
*.tar               binary
*.dat               binary
*.o                 binary
*.obj               binary
*.a                 binary
*.lib               binary
*.so                binary
*.dylib             binary
*.exe               binary
*.cmi               binary
*.cmo               binary
*.cmx               binary

# ─── GitHub language classification ──────────────────────────────────────────
# `.d` is shared by D, DTrace, and Makefile dependency files. bldr is D.
*.d                 linguist-language=D

# Example projects exist to demonstrate the 32 language handlers. Counting
# their sources would report bldr as a JavaScript/Go/Ruby project.
examples/**         linguist-documentation=true
docs/**             linguist-documentation=true

# Generated by `make docs` (DDoc), never hand-edited.
docs/api/**         linguist-generated=true

# Third party — see NOTICE for provenance and licenses.
source/infrastructure/utils/crypto/c/blake3.c       linguist-vendored=true
source/infrastructure/utils/crypto/c/blake3.h       linguist-vendored=true
source/infrastructure/utils/crypto/c/blake3_impl.h  linguist-vendored=true
source/engine/distributed/protocol/proto/reapi_compat.proto linguist-vendored=true
**/node_modules/**  linguist-vendored=true

# ─── Diff drivers ────────────────────────────────────────────────────────────
# Git's builtin hunk-header patterns, so `@@` context names the enclosing
# function instead of a random brace.
*.c                 diff=cpp
*.h                 diff=cpp
*.cpp               diff=cpp
*.rs                diff=rust
*.py                diff=python
*.rb                diff=ruby
*.go                diff=golang
*.java              diff=java
*.cs                diff=csharp
*.php               diff=php
*.html              diff=html
*.md                diff=markdown

# ─── Release archives ────────────────────────────────────────────────────────
# Kept out of `git archive` output, which is what the Homebrew formula and the
# GitHub release tarball consume. Only editor/CI plumbing — nothing `make
# build` reads.
.github/            export-ignore
.vscode/            export-ignore
.editorconfig       export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.cursorignore       export-ignore
.clang-format       export-ignore
